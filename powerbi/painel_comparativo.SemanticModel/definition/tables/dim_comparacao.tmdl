	partition dim_comparacao = calculated
		mode: import
		source =
				VAR _m = DATATABLE("Modalidade", STRING, "OrdM", INTEGER, "ModC", STRING, {{"Presencial", 1, "Presencial"}, {"Curso a distância", 2, "A distância"}, {"Ambas", 3, "Ambas"}})
				VAR _c = DATATABLE("Categoria", STRING, "OrdC", INTEGER, "CatC", STRING, {{"Pública (todas)", 1, "Todas públicas"}, {"Pública Federal", 2, "Púb. Federal"}, {"Pública Estadual", 3, "Púb. Estadual"}, {"Pública Municipal", 4, "Púb. Municipal"}, {"Privada (todas)", 5, "Todas privadas"}, {"Privada com fins lucrativos", 6, "Priv. c/ fins lucr."}, {"Privada sem fins lucrativos", 7, "Priv. s/ fins lucr."}, {"Privada - Particular em sentido estrito", 8, "Priv. particular"}, {"Privada comunitária", 9, "Priv. comunitária"}, {"Privada confessional", 10, "Priv. confessional"}, {"Especial", 11, "Especial"}, {"Ambas", 12, "Ambas"}})
				VAR _k = DATATABLE("Metrica", STRING, "OrdK", INTEGER, "MetC", STRING, {{"Qtde Matrículas", 1, "Matrículas"}, {"Qtde Ingressantes", 2, "Ingressantes"}, {"Qtde Vagas Totais", 3, "Vagas"}, {"Qtde Inscritos", 4, "Inscritos"}, {"Qtde Concluintes", 5, "Concluintes"}, {"Situação Trancada", 6, "Trancadas"}, {"Situação Desligado", 7, "Desligados"}})
				RETURN SELECTCOLUMNS(ADDCOLUMNS(CROSSJOIN(_m, _c, _k), "Rotulo", [ModC] & " · " & [CatC] & " · " & [MetC], "Ordem", [OrdM] * 10000 + [OrdC] * 100 + [OrdK]), "Modalidade", [Modalidade], "OrdM", [OrdM], "Categoria", [Categoria], "OrdC", [OrdC], "Metrica", [Metrica], "OrdK", [OrdK], "Rotulo", [Rotulo], "Ordem", [Ordem])

