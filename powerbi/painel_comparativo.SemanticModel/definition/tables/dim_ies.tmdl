	partition dim_ies = m
		mode: import
		source =
				let
					Source = Python.Execute("# -*- coding: utf-8 -*-#(lf)""""""Script INDIVIDUAL para o Power Query (Get Data > Python script). Gera SO a tabela#(lf)dim_ies. Ver README.md na pasta powerbi/.#(lf)""""""#(lf)import sqlite3#(lf)#(lf)import pandas as pd#(lf)#(lf)DB_PATH = ""D:/Mestrado/Dados/bdados/INEP.db""#(lf)#(lf)con = sqlite3.connect(DB_PATH)#(lf)#(lf)# Modelo em ESTRELA, nao em terceira forma normal (snowflake): cada dimensao se relaciona#(lf)# SO com a fato, nunca com outra dimensao. Por isso NAO trazemos aqui o municipio da IES#(lf)# como FK para dim_territorio (o territorio relevante para os paineis e o da OFERTA do#(lf)# curso, que a fato ja liga direto a dim_territorio via codigo_municipio) -- mantemos so#(lf)# atributos proprios da IES.#(lf)dim_ies = pd.read_sql_query(#(lf)    """"""#(lf)    SELECT#(lf)        codigo          AS codigo_ies,#(lf)        nome            AS nome_ies,#(lf)        sigla           AS sigla_ies#(lf)    FROM superior_ies#(lf)    """""",#(lf)    con,#(lf))#(lf)con.close()#(lf)"),
					Tabela = Source{[Name="dim_ies"]}[Value]
				in
					Tabela

