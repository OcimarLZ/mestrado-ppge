	partition fato_curso_censo = m
		mode: import
		source =
				let
					Source = Python.Execute("# -*- coding: utf-8 -*-#(lf)""""""Script INDIVIDUAL para o Power Query (Get Data > Python script). Gera SO a tabela#(lf)fato_curso_censo. Cada tabela do modelo tem seu proprio script (ver README.md na pasta#(lf)powerbi/) porque o conector Python do Power BI reavalia a arvore de dependencias inteira#(lf)do script a cada tabela carregada -- um unico script com 12 variaveis fazia a fato de#(lf)~3,9M linhas ser relida/reprocessada uma vez por tabela, esgotando a memoria disponivel#(lf)(ArrayMemoryError) mesmo para as dimensoes pequenas.#(lf)""""""#(lf)import sqlite3#(lf)#(lf)import pandas as pd#(lf)#(lf)DB_PATH = ""D:/Mestrado/Dados/bdados/INEP.db""#(lf)ANO_MIN = 2005#(lf)ANO_MAX = 2024#(lf)#(lf)con = sqlite3.connect(DB_PATH)#(lf)#(lf)# Grao: uma linha por curso-oferta x IES x ano_censo. Mantem o codigo de `curso` (a#(lf)# oferta especifica, com nome dado pela propria instituicao) ALEM do cine_rotulo (tipo#(lf)# padronizado) -- os dois sao necessarios: para contar ""quantos cursos distintos"" por#(lf)# IES usa-se `curso`; para comparar por ""tipo de curso"" entre IES/anos usa-se cine_rotulo.#(lf)fato_curso_censo = pd.read_sql_query(#(lf)    f""""""#(lf)    SELECT#(lf)        ano_censo                          AS codigo_ano,#(lf)        CAST(municipio AS INTEGER)         AS codigo_municipio,#(lf)        ies                                 AS codigo_ies,#(lf)        curso                               AS codigo_curso,#(lf)        cine_rotulo                         AS codigo_cine_rotulo,#(lf)        tp_grau_academico                   AS codigo_grau_academico,#(lf)        tp_modalidade_ensino                AS codigo_modalidade_ensino,#(lf)        tp_nivel_academico                  AS codigo_nivel_academico,#(lf)        org_academica                       AS codigo_organizacao_academica,#(lf)        categoria                           AS codigo_categoria_administrativa,#(lf)        tp_rede                             AS codigo_rede,#(lf)        dimensao,#(lf)        in_gratuito,#(lf)        qt_vg_total,#(lf)        qt_mat                              AS qt_vg_mat,#(lf)        qt_ing                              AS qt_vg_ing,#(lf)        qt_conc                             AS qt_vg_conc,#(lf)        qt_sit_trancada,#(lf)        qt_sit_desvinculado                 AS qt_sit_desligado#(lf)    FROM superior_curso_censo#(lf)    WHERE ano_censo BETWEEN {ANO_MIN} AND {ANO_MAX}#(lf)    """""",#(lf)    con,#(lf))#(lf)con.close()#(lf)#(lf)# Reduz drasticamente o uso de memoria (essencial numa fato de ~3,9M linhas): sem isso,#(lf)# o conector Python do Power BI precisa converter o DataFrame (que tem 2 colunas string#(lf)# misturadas com 15 numericas) para um array unico, forcando TUDO para dtype ""object"".#(lf)# codigo_cine_rotulo vira ""category"" (so 785 valores distintos repetidos ~4M vezes --#(lf)# ideal para category, que guarda so um indice inteiro por linha). As colunas inteiras#(lf)# recebem o menor dtype que comporta seus valores (downcast).#(lf)fato_curso_censo[""codigo_cine_rotulo""] = fato_curso_censo[""codigo_cine_rotulo""].astype(""category"")#(lf)for _col in [c for c in fato_curso_censo.columns if c != ""codigo_cine_rotulo""]:#(lf)    fato_curso_censo[_col] = pd.to_numeric(fato_curso_censo[_col], downcast=""integer"")#(lf)"),
					Tabela = Source{[Name="fato_curso_censo"]}[Value]
				in
					Tabela

