table fato_curso_censo
	lineageTag: 63cb2f4b-f5e9-48b0-9cd0-2c3eb154acfd

	measure 'Qtde Cursos' = VAR _ano = MAX(dim_ano[codigo_ano]) VAR _n = CALCULATE(COUNTROWS(fato_curso_censo), dim_ano[codigo_ano] = _ano) RETURN IF(_n = 0, BLANK(), CALCULATE(DISTINCTCOUNT(fato_curso_censo[codigo_curso]), dim_ano[codigo_ano] = _ano))
		formatString: #,0
		lineageTag: 491eae1f-82c6-423f-9025-52344e84bf03

	measure 'Vagas Totais' = VAR _ano = MAX(dim_ano[codigo_ano]) VAR _n = CALCULATE(COUNTROWS(fato_curso_censo), dim_ano[codigo_ano] = _ano) RETURN IF(_n = 0, BLANK(), CALCULATE(SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_total])), dim_ano[codigo_ano] = _ano))
		formatString: #,0
		lineageTag: 28628417-2fac-4369-9cee-8587cca337d1

	measure Ingressantes = VAR _ano = MAX(dim_ano[codigo_ano]) VAR _n = CALCULATE(COUNTROWS(fato_curso_censo), dim_ano[codigo_ano] = _ano) RETURN IF(_n = 0, BLANK(), CALCULATE(SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_ing])), dim_ano[codigo_ano] = _ano))
		formatString: #,0
		lineageTag: 42a517f8-b79f-4080-bdd3-84d3a2404bed

	measure Matrículas = VAR _ano = MAX(dim_ano[codigo_ano]) VAR _n = CALCULATE(COUNTROWS(fato_curso_censo), dim_ano[codigo_ano] = _ano) RETURN IF(_n = 0, BLANK(), CALCULATE(SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_mat])), dim_ano[codigo_ano] = _ano))
		formatString: #,0
		lineageTag: b0df07ff-cde8-48de-a49a-622dacd4153c

	measure Concluintes = VAR _ano = MAX(dim_ano[codigo_ano]) VAR _n = CALCULATE(COUNTROWS(fato_curso_censo), dim_ano[codigo_ano] = _ano) RETURN IF(_n = 0, BLANK(), CALCULATE(SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_conc])), dim_ano[codigo_ano] = _ano))
		formatString: #,0
		lineageTag: 4114a0d4-88bd-44d7-a034-dfb5c6af4e00

	measure Trancadas = VAR _ano = MAX(dim_ano[codigo_ano]) VAR _n = CALCULATE(COUNTROWS(fato_curso_censo), dim_ano[codigo_ano] = _ano) RETURN IF(_n = 0, BLANK(), CALCULATE(SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_sit_trancada])), dim_ano[codigo_ano] = _ano))
		formatString: #,0
		lineageTag: ccb81416-c959-4900-b45f-51256ea0d09f

	measure Desligados = VAR _ano = MAX(dim_ano[codigo_ano]) VAR _n = CALCULATE(COUNTROWS(fato_curso_censo), dim_ano[codigo_ano] = _ano) RETURN IF(_n = 0, BLANK(), CALCULATE(SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_sit_desligado])), dim_ano[codigo_ano] = _ano))
		formatString: #,0
		lineageTag: 7f2570a5-37b2-408b-ad3d-4d3031728d70

	measure 'Titulo Matriz' = "IES e cursos (ano de referência: " & MAX(dim_ano[codigo_ano]) & ")"
		lineageTag: 12e2ab6d-dacc-4170-8ccd-f6b0f0f78182

	measure 'Filtros Selecionados' = VAR _v0 = IF(ISFILTERED(dim_territorio[nome_regiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_regiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_regiao]), dim_territorio[nome_regiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_regiao])) & " itens"), "") VAR _v1 = IF(ISFILTERED(dim_territorio[sigla_uf]), IF(COUNTROWS(VALUES(dim_territorio[sigla_uf])) <= 3, CONCATENATEX(VALUES(dim_territorio[sigla_uf]), dim_territorio[sigla_uf], ", "), COUNTROWS(VALUES(dim_territorio[sigla_uf])) & " itens"), "") VAR _v2 = IF(ISFILTERED(dim_territorio[nome_mesorregiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_mesorregiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_mesorregiao]), dim_territorio[nome_mesorregiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_mesorregiao])) & " itens"), "") VAR _v3 = IF(ISFILTERED(dim_territorio[nome_microrregiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_microrregiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_microrregiao]), dim_territorio[nome_microrregiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_microrregiao])) & " itens"), "") VAR _v4 = IF(ISFILTERED(dim_territorio[nome_municipio]), IF(COUNTROWS(VALUES(dim_territorio[nome_municipio])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_municipio]), dim_territorio[nome_municipio], ", "), COUNTROWS(VALUES(dim_territorio[nome_municipio])) & " itens"), "") VAR _v5 = IF(ISFILTERED(dim_rede[nome_rede]), IF(COUNTROWS(VALUES(dim_rede[nome_rede])) <= 3, CONCATENATEX(VALUES(dim_rede[nome_rede]), dim_rede[nome_rede], ", "), COUNTROWS(VALUES(dim_rede[nome_rede])) & " itens"), "") VAR _v6 = IF(ISFILTERED(dim_categoria_administrativa[nome_categoria_administrativa]), IF(COUNTROWS(VALUES(dim_categoria_administrativa[nome_categoria_administrativa])) <= 3, CONCATENATEX(VALUES(dim_categoria_administrativa[nome_categoria_administrativa]), dim_categoria_administrativa[nome_categoria_administrativa], ", "), COUNTROWS(VALUES(dim_categoria_administrativa[nome_categoria_administrativa])) & " itens"), "") VAR _v7 = IF(ISFILTERED(dim_organizacao_academica[nome_organizacao_academica]), IF(COUNTROWS(VALUES(dim_organizacao_academica[nome_organizacao_academica])) <= 3, CONCATENATEX(VALUES(dim_organizacao_academica[nome_organizacao_academica]), dim_organizacao_academica[nome_organizacao_academica], ", "), COUNTROWS(VALUES(dim_organizacao_academica[nome_organizacao_academica])) & " itens"), "") VAR _v8 = IF(ISFILTERED(dim_grau_academico[nome_grau_academico]), IF(COUNTROWS(VALUES(dim_grau_academico[nome_grau_academico])) <= 3, CONCATENATEX(VALUES(dim_grau_academico[nome_grau_academico]), dim_grau_academico[nome_grau_academico], ", "), COUNTROWS(VALUES(dim_grau_academico[nome_grau_academico])) & " itens"), "") VAR _v9 = IF(ISFILTERED(dim_modalidade_ensino[nome_modalidade_ensino]), IF(COUNTROWS(VALUES(dim_modalidade_ensino[nome_modalidade_ensino])) <= 3, CONCATENATEX(VALUES(dim_modalidade_ensino[nome_modalidade_ensino]), dim_modalidade_ensino[nome_modalidade_ensino], ", "), COUNTROWS(VALUES(dim_modalidade_ensino[nome_modalidade_ensino])) & " itens"), "") VAR _a = IF(_v0 <> "", _v0 & "/", "") & IF(_v1 <> "", _v1 & "/", "") & IF(_v2 <> "", _v2 & "/", "") & IF(_v3 <> "", _v3 & "/", "") & IF(_v4 <> "", _v4 & "/", "") & IF(_v5 <> "", _v5 & "/", "") & IF(_v6 <> "", _v6 & "/", "") & IF(_v7 <> "", _v7 & "/", "") & IF(_v8 <> "", _v8 & "/", "") & IF(_v9 <> "", _v9 & "/", "") RETURN IF(_a = "", "", LEFT(_a, LEN(_a) - 1))
		lineageTag: afb9e78e-7e3c-45a5-8eba-d9f7562a2ea5

	measure 'Subtitulo Filtros' = VAR _f = [Filtros Selecionados] RETURN IF(_f = "", "", "(" & _f & ")")
		lineageTag: ca17f8d1-49b8-4cd4-947f-4cd07e7ced10

	measure Sigla = VAR _ano = MAX(dim_ano[codigo_ano]) VAR _n = CALCULATE(COUNTROWS(fato_curso_censo), dim_ano[codigo_ano] = _ano) RETURN IF(_n = 0, BLANK(), IF(ISINSCOPE(dim_ies[nome_ies]), SELECTEDVALUE(dim_ies[sigla_ies]), FORMAT(CALCULATE(DISTINCTCOUNT(fato_curso_censo[codigo_ies]), dim_ano[codigo_ano] = _ano), "#,0") & " IES"))
		lineageTag: 47bdec63-94ee-4d73-8a3e-139bdf4b1c94

	measure UF = VAR _ano = MAX(dim_ano[codigo_ano]) VAR _n = CALCULATE(COUNTROWS(fato_curso_censo), dim_ano[codigo_ano] = _ano) RETURN IF(_n = 0 || NOT ISINSCOPE(dim_ies[nome_ies]) , BLANK(), SELECTEDVALUE(dim_ies[sigla_uf_ies]))
		lineageTag: 1cb30643-9cd0-4258-b184-b6d2ee3e909e

