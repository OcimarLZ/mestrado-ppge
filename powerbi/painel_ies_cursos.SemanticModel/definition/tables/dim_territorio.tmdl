	partition dim_territorio = m
		mode: import
		source =
				let
					Source = Python.Execute("# -*- coding: utf-8 -*-#(lf)""""""Script INDIVIDUAL para o Power Query (Get Data > Python script). Gera SO a tabela#(lf)dim_territorio. Ver README.md na pasta powerbi/ para o porque de cada tabela ter seu#(lf)proprio script em vez de um unico script com todas as variaveis.#(lf)""""""#(lf)import sqlite3#(lf)#(lf)import pandas as pd#(lf)#(lf)DB_PATH = ""D:/Mestrado/Dados/bdados/INEP.db""#(lf)#(lf)con = sqlite3.connect(DB_PATH)#(lf)#(lf)# Hierarquia territorial completa (municipio -> microrregiao -> mesorregiao -> UF ->#(lf)# regiao) numa UNICA tabela ja achatada -- modelo em estrela: liga direto na fato por#(lf)# codigo_municipio, sem nenhuma dimensao encadeada em outra dimensao.#(lf)dim_territorio = pd.read_sql_query(#(lf)    """"""#(lf)    SELECT#(lf)        CAST(m.codigo AS INTEGER) AS codigo_municipio,#(lf)        m.nome          AS nome_municipio,#(lf)        mic.codigo      AS codigo_microrregiao,#(lf)        mic.nome        AS nome_microrregiao,#(lf)        mes.codigo      AS codigo_mesorregiao,#(lf)        mes.nome        AS nome_mesorregiao,#(lf)        uf.sigla        AS sigla_uf,#(lf)        uf.nome         AS nome_uf,#(lf)        r.codigo        AS codigo_regiao,#(lf)        r.nome          AS nome_regiao,#(lf)        m.regiao_intermediaria,#(lf)        m.regiao_imediata#(lf)    FROM comum_municipio m#(lf)    LEFT JOIN comum_microrregiao mic ON mic.codigo = m.microrregiao#(lf)    LEFT JOIN comum_mesorregiao mes ON mes.codigo = m.mesorregiao#(lf)    LEFT JOIN comum_uf uf ON uf.sigla = m.uf#(lf)    LEFT JOIN comum_regiao r ON r.codigo = uf.regiao#(lf)    """""",#(lf)    con,#(lf))#(lf)con.close()#(lf)#(lf)dim_territorio[""codigo_municipio""] = pd.to_numeric(dim_territorio[""codigo_municipio""], downcast=""integer"")#(lf)"),
					Tabela = Source{[Name="dim_territorio"]}[Value]
				in
					Tabela

