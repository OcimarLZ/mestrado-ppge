table fato_curso_censo
	lineageTag: f7b828d4-274c-4c5e-90f4-9ca50ea60a23

	measure 'Qtde Matrículas' = IF("Qtde Matrículas" IN VALUES('Metricas Parametro'[Metricas Parametro]), SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_mat])), BLANK())
		formatString: #,0
		lineageTag: 0e5a90cf-5863-4dac-80c7-43960a795bc2

	measure 'Qtde Ingressantes' = IF("Qtde Ingressantes" IN VALUES('Metricas Parametro'[Metricas Parametro]), SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_ing])), BLANK())
		formatString: #,0
		lineageTag: bf142236-c721-4ec7-aa65-d6c241466217

	measure 'Qtde Vagas Totais' = IF("Qtde Vagas Totais" IN VALUES('Metricas Parametro'[Metricas Parametro]), SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_total])), BLANK())
		formatString: #,0
		lineageTag: a2827829-6da1-47e4-b1ce-9fafe2c05ace

	measure 'Qtde Inscritos' = IF("Qtde Inscritos" IN VALUES('Metricas Parametro'[Metricas Parametro]), SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_inscrito_total])), BLANK())
		formatString: #,0
		lineageTag: d7d1368b-af5a-4346-96f9-7256a98fa249

	measure 'Qtde Concluintes' = IF("Qtde Concluintes" IN VALUES('Metricas Parametro'[Metricas Parametro]), SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_conc])), BLANK())
		formatString: #,0
		lineageTag: 708411ac-0363-487d-94bc-59d84546010f

	measure 'Situação Trancada' = IF("Situação Trancada" IN VALUES('Metricas Parametro'[Metricas Parametro]), SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_sit_trancada])), BLANK())
		formatString: #,0
		lineageTag: 2a32fff8-e6e7-483a-8c4b-f3e909e876fa

	measure 'Situação Desligado' = IF("Situação Desligado" IN VALUES('Metricas Parametro'[Metricas Parametro]), SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_sit_desligado])), BLANK())
		formatString: #,0
		lineageTag: 1fc6d5fe-8908-42da-8072-84801e1cc33c

	measure 'Filtros Selecionados' = VAR _v0 = IF(ISFILTERED(dim_territorio[nome_regiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_regiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_regiao]), dim_territorio[nome_regiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_regiao])) & " itens"), "") VAR _v1 = IF(ISFILTERED(dim_territorio[sigla_uf]), IF(COUNTROWS(VALUES(dim_territorio[sigla_uf])) <= 3, CONCATENATEX(VALUES(dim_territorio[sigla_uf]), dim_territorio[sigla_uf], ", "), COUNTROWS(VALUES(dim_territorio[sigla_uf])) & " itens"), "") VAR _v2 = IF(ISFILTERED(dim_territorio[nome_mesorregiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_mesorregiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_mesorregiao]), dim_territorio[nome_mesorregiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_mesorregiao])) & " itens"), "") VAR _v3 = IF(ISFILTERED(dim_territorio[nome_microrregiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_microrregiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_microrregiao]), dim_territorio[nome_microrregiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_microrregiao])) & " itens"), "") VAR _v4 = IF(ISFILTERED(dim_territorio[nome_municipio]), IF(COUNTROWS(VALUES(dim_territorio[nome_municipio])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_municipio]), dim_territorio[nome_municipio], ", "), COUNTROWS(VALUES(dim_territorio[nome_municipio])) & " itens"), "") VAR _v5 = IF(ISFILTERED(dim_rede[nome_rede]), IF(COUNTROWS(VALUES(dim_rede[nome_rede])) <= 3, CONCATENATEX(VALUES(dim_rede[nome_rede]), dim_rede[nome_rede], ", "), COUNTROWS(VALUES(dim_rede[nome_rede])) & " itens"), "") VAR _v6 = IF(ISFILTERED(dim_categoria_administrativa[nome_categoria_administrativa]), IF(COUNTROWS(VALUES(dim_categoria_administrativa[nome_categoria_administrativa])) <= 3, CONCATENATEX(VALUES(dim_categoria_administrativa[nome_categoria_administrativa]), dim_categoria_administrativa[nome_categoria_administrativa], ", "), COUNTROWS(VALUES(dim_categoria_administrativa[nome_categoria_administrativa])) & " itens"), "") VAR _v7 = IF(ISFILTERED(dim_modalidade_ensino[nome_modalidade_ensino]), IF(COUNTROWS(VALUES(dim_modalidade_ensino[nome_modalidade_ensino])) <= 3, CONCATENATEX(VALUES(dim_modalidade_ensino[nome_modalidade_ensino]), dim_modalidade_ensino[nome_modalidade_ensino], ", "), COUNTROWS(VALUES(dim_modalidade_ensino[nome_modalidade_ensino])) & " itens"), "") VAR _v8 = IF(ISFILTERED(dim_organizacao_academica[nome_organizacao_academica]), IF(COUNTROWS(VALUES(dim_organizacao_academica[nome_organizacao_academica])) <= 3, CONCATENATEX(VALUES(dim_organizacao_academica[nome_organizacao_academica]), dim_organizacao_academica[nome_organizacao_academica], ", "), COUNTROWS(VALUES(dim_organizacao_academica[nome_organizacao_academica])) & " itens"), "") VAR _v9 = IF(ISFILTERED(dim_grau_academico[nome_grau_academico]), IF(COUNTROWS(VALUES(dim_grau_academico[nome_grau_academico])) <= 3, CONCATENATEX(VALUES(dim_grau_academico[nome_grau_academico]), dim_grau_academico[nome_grau_academico], ", "), COUNTROWS(VALUES(dim_grau_academico[nome_grau_academico])) & " itens"), "") VAR _v10 = IF(ISFILTERED(dim_cine[nome_area_geral]), IF(COUNTROWS(VALUES(dim_cine[nome_area_geral])) <= 3, CONCATENATEX(VALUES(dim_cine[nome_area_geral]), dim_cine[nome_area_geral], ", "), COUNTROWS(VALUES(dim_cine[nome_area_geral])) & " itens"), "") VAR _v11 = IF(ISFILTERED(dim_cine[nome_area_detalhada]), IF(COUNTROWS(VALUES(dim_cine[nome_area_detalhada])) <= 3, CONCATENATEX(VALUES(dim_cine[nome_area_detalhada]), dim_cine[nome_area_detalhada], ", "), COUNTROWS(VALUES(dim_cine[nome_area_detalhada])) & " itens"), "") VAR _v12 = IF(ISFILTERED(dim_cine[nome_cine_rotulo]), IF(COUNTROWS(VALUES(dim_cine[nome_cine_rotulo])) <= 3, CONCATENATEX(VALUES(dim_cine[nome_cine_rotulo]), dim_cine[nome_cine_rotulo], ", "), COUNTROWS(VALUES(dim_cine[nome_cine_rotulo])) & " itens"), "") VAR _a = IF(_v0 <> "", _v0 & "/", "") & IF(_v1 <> "", _v1 & "/", "") & IF(_v2 <> "", _v2 & "/", "") & IF(_v3 <> "", _v3 & "/", "") & IF(_v4 <> "", _v4 & "/", "") & IF(_v5 <> "", _v5 & "/", "") & IF(_v6 <> "", _v6 & "/", "") & IF(_v7 <> "", _v7 & "/", "") & IF(_v8 <> "", _v8 & "/", "") & IF(_v9 <> "", _v9 & "/", "") & IF(_v10 <> "", _v10 & "/", "") & IF(_v11 <> "", _v11 & "/", "") & IF(_v12 <> "", _v12 & "/", "") RETURN IF(_a = "", "", LEFT(_a, LEN(_a) - 1))
		lineageTag: d8a579f6-a2f4-442a-a9a8-b9eecf06e5d7

	measure 'Subtitulo Filtros' = VAR _f = [Filtros Selecionados] RETURN IF(_f = "", "", "(" & _f & ")")
		lineageTag: e3938d6f-964a-46b2-b372-d63ab9b095eb

