table fato_ies_censo
	lineageTag: 8ffffa60-604a-44ae-ba75-270853b14c63

	measure 'Valor Selecionado' = VAR _metrica = SELECTEDVALUE(dim_metricas[Metrica]) VAR _qt_doc_total = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_total])) VAR _qt_doc_exe = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_exe])) VAR _qt_doc_ex_femi = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_femi])) VAR _qt_doc_ex_masc = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_masc])) VAR _qt_doc_ex_dout = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_dout])) VAR _qt_doc_ex_mest = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_mest])) VAR _qt_doc_ex_esp = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_esp])) VAR _qt_doc_ex_grad = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_grad])) VAR _qt_doc_ex_sem_grad = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_sem_grad])) VAR _qt_doc_ex_int = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_int])) VAR _qt_doc_ex_int_de = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_int_de])) VAR _qt_doc_ex_parc = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_parc])) VAR _qt_doc_ex_hor = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_hor])) VAR _qt_doc_ex_com_deficiencia = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_com_deficiencia])) VAR _qt_doc_ex_est = SUMX(fato_ies_censo, VALUE(fato_ies_censo[qt_doc_ex_est])) RETURN SWITCH(_metrica, "Docentes (total)", _qt_doc_total, "Docentes em exercício", _qt_doc_exe, "Docentes mulheres", _qt_doc_ex_femi, "Docentes homens", _qt_doc_ex_masc, "Doutores", _qt_doc_ex_dout, "Mestres", _qt_doc_ex_mest, "Especialistas", _qt_doc_ex_esp, "Graduados", _qt_doc_ex_grad, "Sem graduação", _qt_doc_ex_sem_grad, "Regime integral", _qt_doc_ex_int, "Integral com DE", _qt_doc_ex_int_de, "Regime parcial", _qt_doc_ex_parc, "Horistas", _qt_doc_ex_hor, "Com deficiência", _qt_doc_ex_com_deficiencia, "Estrangeiros", _qt_doc_ex_est, _qt_doc_total)
		formatString: #,0
		lineageTag: fbe98d94-80d2-432f-bf9b-5bc7e3d13443

	measure 'Valor Acumulado' = VAR _ano = MAX(dim_ano[codigo_ano]) RETURN CALCULATE([Valor Selecionado], FILTER(ALL(dim_ano[codigo_ano]), dim_ano[codigo_ano] <= _ano))
		formatString: #,0
		lineageTag: b6854316-c29b-4b6a-8e0d-5836fb5a966d

	measure 'Qtde IES' = CALCULATE(DISTINCTCOUNT(fato_ies_censo[codigo_ies]), fato_ies_censo[codigo_ies] <> 0)
		formatString: #,0
		lineageTag: 0aec61b3-8740-44d8-8bcb-e81da67e6d33

	measure 'Titulo Metrica' = SELECTEDVALUE(dim_metricas[Metrica], "Docentes (total)")
		lineageTag: 8b4a0ead-d5a8-4c85-83a9-e908e4e81a9f

	measure 'Filtros Selecionados' = VAR _v0 = IF(ISFILTERED(dim_territorio[nome_regiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_regiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_regiao]), dim_territorio[nome_regiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_regiao])) & " itens"), "") VAR _v1 = IF(ISFILTERED(dim_territorio[sigla_uf]), IF(COUNTROWS(VALUES(dim_territorio[sigla_uf])) <= 3, CONCATENATEX(VALUES(dim_territorio[sigla_uf]), dim_territorio[sigla_uf], ", "), COUNTROWS(VALUES(dim_territorio[sigla_uf])) & " itens"), "") VAR _v2 = IF(ISFILTERED(dim_territorio[nome_mesorregiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_mesorregiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_mesorregiao]), dim_territorio[nome_mesorregiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_mesorregiao])) & " itens"), "") VAR _v3 = IF(ISFILTERED(dim_territorio[nome_microrregiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_microrregiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_microrregiao]), dim_territorio[nome_microrregiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_microrregiao])) & " itens"), "") VAR _v4 = IF(ISFILTERED(dim_territorio[nome_municipio]), IF(COUNTROWS(VALUES(dim_territorio[nome_municipio])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_municipio]), dim_territorio[nome_municipio], ", "), COUNTROWS(VALUES(dim_territorio[nome_municipio])) & " itens"), "") VAR _v5 = IF(ISFILTERED(dim_rede[nome_rede]), IF(COUNTROWS(VALUES(dim_rede[nome_rede])) <= 3, CONCATENATEX(VALUES(dim_rede[nome_rede]), dim_rede[nome_rede], ", "), COUNTROWS(VALUES(dim_rede[nome_rede])) & " itens"), "") VAR _v6 = IF(ISFILTERED(dim_categoria_administrativa[nome_categoria_administrativa]), IF(COUNTROWS(VALUES(dim_categoria_administrativa[nome_categoria_administrativa])) <= 3, CONCATENATEX(VALUES(dim_categoria_administrativa[nome_categoria_administrativa]), dim_categoria_administrativa[nome_categoria_administrativa], ", "), COUNTROWS(VALUES(dim_categoria_administrativa[nome_categoria_administrativa])) & " itens"), "") VAR _v7 = IF(ISFILTERED(dim_organizacao_academica[nome_organizacao_academica]), IF(COUNTROWS(VALUES(dim_organizacao_academica[nome_organizacao_academica])) <= 3, CONCATENATEX(VALUES(dim_organizacao_academica[nome_organizacao_academica]), dim_organizacao_academica[nome_organizacao_academica], ", "), COUNTROWS(VALUES(dim_organizacao_academica[nome_organizacao_academica])) & " itens"), "") VAR _a = IF(_v0 <> "", _v0 & "/", "") & IF(_v1 <> "", _v1 & "/", "") & IF(_v2 <> "", _v2 & "/", "") & IF(_v3 <> "", _v3 & "/", "") & IF(_v4 <> "", _v4 & "/", "") & IF(_v5 <> "", _v5 & "/", "") & IF(_v6 <> "", _v6 & "/", "") & IF(_v7 <> "", _v7 & "/", "") RETURN IF(_a = "", "", LEFT(_a, LEN(_a) - 1))
		lineageTag: c7fbb79a-50d9-41e5-bc99-d04512248d20

	measure 'Subtitulo Filtros' = VAR _f = [Filtros Selecionados] RETURN IF(_f = "", "", "(" & _f & ")")
		lineageTag: 07d1deea-71ba-4082-82a6-0a2f2413b15e

