	partition fato_ies_censo = m
		mode: import
		source =
				let
					Source = Python.Execute("# -*- coding: utf-8 -*-#(lf)""""""Script INDIVIDUAL para o Power Query (Get Data > Python script). Gera SO a tabela#(lf)fato_ies_censo. Grao: uma linha por IES x ano_censo (~50 mil linhas), com a quantidade#(lf)de docentes em varios recortes (sexo, titulacao, regime de trabalho etc.).#(lf)#(lf)Observacoes sobre os dados de origem: nao ha registros do Censo 2009; em 2005 cada IES#(lf)aparece em 2 linhas com valores fracionados (.5) que, somadas, preservam o total; e#(lf)`ies = 0` agrupa instituicoes nao identificadas.#(lf)""""""#(lf)import sqlite3#(lf)#(lf)import pandas as pd#(lf)#(lf)DB_PATH = ""D:/Mestrado/Dados/bdados/INEP.db""#(lf)ANO_MIN = 2004#(lf)ANO_MAX = 2024#(lf)#(lf)con = sqlite3.connect(DB_PATH)#(lf)fato_ies_censo = pd.read_sql_query(#(lf)    f""""""#(lf)    SELECT#(lf)        ano_censo                          AS codigo_ano,#(lf)        CAST(municipio AS INTEGER)         AS codigo_municipio,#(lf)        ies                                AS codigo_ies,#(lf)        mantenedora                        AS codigo_mantenedora,#(lf)        org_academica                      AS codigo_organizacao_academica,#(lf)        categoria                          AS codigo_categoria_administrativa,#(lf)        tp_rede                            AS codigo_rede,#(lf)        qt_doc_total,#(lf)        qt_doc_exe,#(lf)        qt_doc_ex_femi,#(lf)        qt_doc_ex_masc,#(lf)        qt_doc_ex_dout,#(lf)        qt_doc_ex_mest,#(lf)        qt_doc_ex_esp,#(lf)        qt_doc_ex_grad,#(lf)        qt_doc_ex_sem_grad,#(lf)        qt_doc_ex_int,#(lf)        qt_doc_ex_int_de,#(lf)        qt_doc_ex_parc,#(lf)        qt_doc_ex_hor,#(lf)        qt_doc_ex_com_deficiencia,#(lf)        qt_doc_ex_est#(lf)    FROM superior_ies_censo#(lf)    WHERE ano_censo BETWEEN {ANO_MIN} AND {ANO_MAX}#(lf)    """""",#(lf)    con,#(lf))#(lf)con.close()#(lf)#(lf)# Menor dtype que comporta os valores (colunas com .5 de 2005 permanecem float).#(lf)for _col in fato_ies_censo.columns:#(lf)    fato_ies_censo[_col] = pd.to_numeric(fato_ies_censo[_col], downcast=""integer"")#(lf)"),
					Tabela = Source{[Name="fato_ies_censo"]}[Value]
				in
					Tabela

