	partition dim_mantenedora = m
		mode: import
		source =
				let
					Source = Python.Execute("# -*- coding: utf-8 -*-#(lf)""""""Script INDIVIDUAL para o Power Query (Get Data > Python script). Gera SO a tabela#(lf)dim_mantenedora (entidade mantenedora da IES). Ver README.md na pasta powerbi/.#(lf)""""""#(lf)import sqlite3#(lf)#(lf)import pandas as pd#(lf)#(lf)DB_PATH = ""D:/Mestrado/Dados/bdados/INEP.db""#(lf)#(lf)con = sqlite3.connect(DB_PATH)#(lf)dim_mantenedora = pd.read_sql_query(#(lf)    ""SELECT codigo AS codigo_mantenedora, nome AS nome_mantenedora FROM superior_mantenedora"",#(lf)    con,#(lf))#(lf)con.close()#(lf)"),
					Tabela = Source{[Name="dim_mantenedora"]}[Value]
				in
					Tabela

