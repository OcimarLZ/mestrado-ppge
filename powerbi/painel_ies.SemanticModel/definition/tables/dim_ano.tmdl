		source =
				let
					Source = Python.Execute("# -*- coding: utf-8 -*-#(lf)""""""Script INDIVIDUAL para o Power Query (Get Data > Python script). Gera SO a tabela#(lf)dim_ano (tabela calendario simplificada -- so ano, sem mes/dia). Ver README.md na pasta#(lf)powerbi/.#(lf)""""""#(lf)import pandas as pd#(lf)#(lf)ANO_MIN = 2004#(lf)ANO_MAX = 2024#(lf)#(lf)dim_ano = pd.DataFrame({""codigo_ano"": range(ANO_MIN, ANO_MAX + 1)})#(lf)dim_ano[""decada""] = (dim_ano[""codigo_ano""] // 10 * 10).astype(str) + ""s""#(lf)dim_ano[""periodo_pne_2014_2024""] = dim_ano[""codigo_ano""].between(2014, 2024)#(lf)"),
					Tabela = Source{[Name="dim_ano"]}[Value]
