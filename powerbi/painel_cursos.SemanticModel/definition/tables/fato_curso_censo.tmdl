table fato_curso_censo
	lineageTag: f7b828d4-274c-4c5e-90f4-9ca50ea60a23

	measure 'Valor Selecionado' = VAR _metrica = SELECTEDVALUE(dim_metricas[Metrica]) VAR _qt_vg_mat = SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_mat])) VAR _qt_vg_ing = SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_ing])) VAR _qt_vg_total = SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_total])) VAR _qt_vg_conc = SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_vg_conc])) VAR _qt_sit_trancada = SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_sit_trancada])) VAR _qt_sit_desligado = SUMX(fato_curso_censo, VALUE(fato_curso_censo[qt_sit_desligado])) RETURN SWITCH(_metrica, "Qtde Matrículas", _qt_vg_mat, "Qtde Ingressantes", _qt_vg_ing, "Qtde Vagas Totais", _qt_vg_total, "Qtde Concluintes", _qt_vg_conc, "Situação Trancada", _qt_sit_trancada, "Situação Desligado", _qt_sit_desligado, _qt_vg_mat)
		formatString: 0
		lineageTag: 11827a1f-6c2c-4502-a268-40b185a9fbda

	measure 'Valor Acumulado' = VAR _ano = MAX(dim_ano[codigo_ano]) RETURN CALCULATE([Valor Selecionado], FILTER(ALL(dim_ano[codigo_ano]), dim_ano[codigo_ano] <= _ano))
		formatString: 0
		lineageTag: 6f1d2c3a-5b7e-4c8d-9a10-2e3f4a5b6c7d

	measure 'Titulo Metrica' = SELECTEDVALUE(dim_metricas[Metrica], "Qtde Matrículas")
		lineageTag: 3c9a7e52-8d41-4f6b-b1a7-5d2e9f0c4a18

	measure 'Filtros Selecionados' = VAR _v0 = IF(ISFILTERED(dim_territorio[nome_regiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_regiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_regiao]), dim_territorio[nome_regiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_regiao])) & " itens"), "") VAR _v1 = IF(ISFILTERED(dim_territorio[sigla_uf]), IF(COUNTROWS(VALUES(dim_territorio[sigla_uf])) <= 3, CONCATENATEX(VALUES(dim_territorio[sigla_uf]), dim_territorio[sigla_uf], ", "), COUNTROWS(VALUES(dim_territorio[sigla_uf])) & " itens"), "") VAR _v2 = IF(ISFILTERED(dim_territorio[nome_mesorregiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_mesorregiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_mesorregiao]), dim_territorio[nome_mesorregiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_mesorregiao])) & " itens"), "") VAR _v3 = IF(ISFILTERED(dim_territorio[nome_microrregiao]), IF(COUNTROWS(VALUES(dim_territorio[nome_microrregiao])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_microrregiao]), dim_territorio[nome_microrregiao], ", "), COUNTROWS(VALUES(dim_territorio[nome_microrregiao])) & " itens"), "") VAR _v4 = IF(ISFILTERED(dim_territorio[nome_municipio]), IF(COUNTROWS(VALUES(dim_territorio[nome_municipio])) <= 3, CONCATENATEX(VALUES(dim_territorio[nome_municipio]), dim_territorio[nome_municipio], ", "), COUNTROWS(VALUES(dim_territorio[nome_municipio])) & " itens"), "") VAR _v5 = IF(ISFILTERED(dim_rede[nome_rede]), IF(COUNTROWS(VALUES(dim_rede[nome_rede])) <= 3, CONCATENATEX(VALUES(dim_rede[nome_rede]), dim_rede[nome_rede], ", "), COUNTROWS(VALUES(dim_rede[nome_rede])) & " itens"), "") VAR _v6 = IF(ISFILTERED(dim_modalidade_ensino[nome_modalidade_ensino]), IF(COUNTROWS(VALUES(dim_modalidade_ensino[nome_modalidade_ensino])) <= 3, CONCATENATEX(VALUES(dim_modalidade_ensino[nome_modalidade_ensino]), dim_modalidade_ensino[nome_modalidade_ensino], ", "), COUNTROWS(VALUES(dim_modalidade_ensino[nome_modalidade_ensino])) & " itens"), "") VAR _v7 = IF(ISFILTERED(dim_organizacao_academica[nome_organizacao_academica]), IF(COUNTROWS(VALUES(dim_organizacao_academica[nome_organizacao_academica])) <= 3, CONCATENATEX(VALUES(dim_organizacao_academica[nome_organizacao_academica]), dim_organizacao_academica[nome_organizacao_academica], ", "), COUNTROWS(VALUES(dim_organizacao_academica[nome_organizacao_academica])) & " itens"), "") VAR _v8 = IF(ISFILTERED(dim_grau_academico[nome_grau_academico]), IF(COUNTROWS(VALUES(dim_grau_academico[nome_grau_academico])) <= 3, CONCATENATEX(VALUES(dim_grau_academico[nome_grau_academico]), dim_grau_academico[nome_grau_academico], ", "), COUNTROWS(VALUES(dim_grau_academico[nome_grau_academico])) & " itens"), "") VAR _a = IF(_v0 <> "", _v0 & "/", "") & IF(_v1 <> "", _v1 & "/", "") & IF(_v2 <> "", _v2 & "/", "") & IF(_v3 <> "", _v3 & "/", "") & IF(_v4 <> "", _v4 & "/", "") & IF(_v5 <> "", _v5 & "/", "") & IF(_v6 <> "", _v6 & "/", "") & IF(_v7 <> "", _v7 & "/", "") & IF(_v8 <> "", _v8 & "/", "") RETURN IF(_a = "", "", LEFT(_a, LEN(_a) - 1))
		lineageTag: 7b2e4d10-93c5-4a8f-8e61-0c5d7a3f9b24

	measure 'Subtitulo Filtros' = VAR _f = [Filtros Selecionados] RETURN IF(_f = "", "", "(" & _f & ")")
		lineageTag: 91d6a3f7-2c48-4e0b-a5d9-6f1b8e7c3a52

