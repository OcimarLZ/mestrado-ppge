				let
					Source = Python.Execute("# -*- coding: utf-8 -*-#(lf)""""""Script INDIVIDUAL para o Power Query (Get Data > Python script). Gera SO a tabela#(lf)dim_versao (rastreabilidade: quando os dados foram extraidos do banco). Ver README.md na#(lf)pasta powerbi/.#(lf)""""""#(lf)from datetime import datetime, timezone#(lf)#(lf)import pandas as pd#(lf)#(lf)ANO_MIN = 2005#(lf)ANO_MAX = 2024#(lf)#(lf)dim_versao = pd.DataFrame(#(lf)    {#(lf)        ""data_extracao"": [datetime.now(timezone.utc).isoformat()],#(lf)        ""fonte"": [""INEP - Censo da Educação Superior (microdados)""],#(lf)        ""ano_min"": [ANO_MIN],#(lf)        ""ano_max"": [ANO_MAX],#(lf)    }#(lf))#(lf)"),
